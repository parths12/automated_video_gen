# LLM: mock | anthropic | openai | gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_from_aistudio_google_com
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Video: storyboard_only | kenburns | gemini_veo (Veo 2 animated clips)
VIDEO_BACKEND=gemini_veo
GEMINI_VEO_MODEL=veo-2.0-generate-001
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
VEO_POLL_SECONDS=15
VEO_MAX_DURATION=8

# TTS (optional — falls back to gTTS)
ELEVENLABS_API_KEY=

# Evaluation (optional)
