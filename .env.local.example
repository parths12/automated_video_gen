# Fully offline pipeline — no API keys required
LLM_PROVIDER=local
# local_image = SDXL keyframes (fast) | local_video = Wan T2V (needs *-Diffusers* model)
VIDEO_BACKEND=local_image
LOCAL_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers

# Hugging Face models (downloaded to models/hf_cache on first run)
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_IMAGE_MODEL=stabilityai/sdxl-turbo
LOCAL_DEVICE=cuda:1
HF_HOME=/mnt/data0/parth/hf_models_cache
HF_HUB_CACHE=/mnt/data0/parth/hf_models_cache
# export HF_TOKEN=hf_xxx   # set in shell before download_models.sh
LOCAL_FRAMES_PER_SCENE=3
LOCAL_IMAGE_SEED=42
